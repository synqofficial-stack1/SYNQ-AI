{
  "expo": {
    "name": "Synq AI",
    "slug": "synq-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/synq-app-icon.png",
    "scheme": "synqai",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.synq.ai",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/images/synq-app-icon.png"
    },
    "android": {
      "package": "com.synq.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android/synq-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android/synq-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/synq-app-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62159878-b95c-473c-b9c5-945e5152ffd9"
      }
    },
    "owner": "vishukumar"
  }
}
