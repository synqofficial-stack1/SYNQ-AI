# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Required by the current Synq app client as well
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
GEMINI_API_KEY=
# fal.ai video generation; configure as a Supabase Edge Function secret (never EXPO_PUBLIC_).
FAL_AI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Vapi browser voice test. These identifiers are public and safe for the client.
EXPO_PUBLIC_VAPI_PUBLIC_KEY=
EXPO_PUBLIC_VAPI_ASSISTANT_ID=

# Social integrations
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Synq's YouTube Edge Functions use these server-side variable names
YOUTUBE_GOOGLE_CONSOLE_CLIENT_ID=
YOUTUBE_GOOGLE_CONSOLE_CLIENT_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Image generation: set these in Supabase Edge Function secrets, not EXPO_PUBLIC variables.
# Keep GEMINI_API_KEY above for chat and other existing Gemini features.
POLLINATIONS_API_KEY=
# Optional Pollinations raster image model override
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
